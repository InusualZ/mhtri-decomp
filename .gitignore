# IDE folders
.idea/
.vs/

# Caches
__pycache__
.mypy_cache
.cache/

# Original files
orig/*/*
!orig/*/.gitkeep
*.dol
*.rel
*.elf
*.o
*.map
*.MAP

# Build files
build/
.ninja_*
build.ninja

# decompctx output
ctx.*
*.ctx

# Generated configs
objdiff.json
compile_commands.json

# Miscellaneous
/*.txt
*.exe

/.lavish
# /.pi/ stays ignored in full: it is agent scratch (notes, prompts, scratch), not repo content.
/.pi/*
# Claude Code project config: the subagent profiles (.claude/agents) and skills (.claude/skills) are tracked so
# every lane and every harness session shares them. Everything else under .claude/ (settings.local.json,
# worktrees, scratch) stays local.  (The parent directory itself must not be excluded, or git never descends.)
/.claude/*
!/.claude/skills/
!/.claude/agents/
!/.claude/settings.json
/openspec

# generated by tools/units/brief.py (per-unit worker briefs; regenerated on demand)
tools/units/briefs/

# objdiff-cli scratch output when a tool is invoked straight from the repo root (writes
d[0-9]*.json
t[0-9]*.json
# a lane worktree created inside the repo root must never be staged
.ws-*/

# a slot's occupancy sentinel: tools/units/slots.py creates `.used` in the slot worktree root on acquire and
# removes it on release. It is intentionally invisible to git so an occupied slot's tree stays clean.
.used
