# IDE folders
.idea/
.vs/

# Caches
__pycache__
.mypy_cache
.cache/

# Original files
orig/*/*
!orig/*/.gitkeep
*.dol
*.rel
*.elf
*.o
*.map
*.MAP

# Build files
build/
.ninja_*
build.ninja

# decompctx output
ctx.*
*.ctx

# Generated configs
objdiff.json
compile_commands.json

# Miscellaneous
/*.txt
*.exe

/.lavish
# /.pi/ stays ignored in full: it is agent scratch (notes, prompts, scratch), not repo content.
/.pi/*
# /.agents/ stays ignored except the skills folder, which is tracked in full so every skill is shared
# with every harness.  (The parent directory itself must not be excluded, or git never descends into it.)
/.agents/*
!/.agents/skills/
# ...and the subagent profiles, so the decompiler/worker role definitions are shared and reviewable.
# The live copies the harness reads are installed under ~/.pi/agent/agents/ (see AGENTS.md).
!/.agents/agents/
/openspec

# generated by tools/units/brief.py (per-unit worker briefs; regenerated on demand)
tools/units/briefs/

# objdiff-cli scratch output when a tool is invoked straight from the repo root (writes
d[0-9]*.json
t[0-9]*.json
# a lane worktree created inside the repo root must never be staged
.ws-*/
