#!/bin/sh
# Pre-commit guard (docs/plan.md 7.18). Refuses a commit that carries any of the four things this repository
# must never commit, whichever path the commit takes - a worker's plain `git commit` on its branch included,
# which is exactly the case prepcommit.py cannot see.
#
# Enable once per clone/worktree:
#     git config core.hooksPath tools/git/hooks
# It is belt-and-braces, not the enforcement: prepcommit.py refuses the same paths (and cross-checks the DOL
# hash) without depending on a hook being active. See docs/plan.md section 7.18.

staged=$(git diff --cached --name-only --diff-filter=ACMR)

bad=$(printf '%s\n' "$staged" | grep -E '^(orig/|build/|config/RMHE08/(build\.sha1|config\.yml))$' || true)
if [ -n "$bad" ]; then
    echo "pre-commit: refusing to commit:" >&2
    printf '  %s\n' $bad >&2
    echo "  orig/** is the original game data (non-negotiable 1) and build/** is build output (rule 2);" >&2
    echo "  config/RMHE08/build.sha1 and config.yml are the DOL's ground truth - rewriting either voids" >&2
    echo "  every later 'ninja build/RMHE08/ok' (docs/plan.md 7.18)." >&2
    exit 1
fi

# The LOCAL-ONLY working-state block is never committed (non-negotiable 8). prepcommit.py pulls it before
# staging; this catches a hand-run `git add AGENTS.md && git commit` instead.
if printf '%s\n' "$staged" | grep -q '^AGENTS\.md$'; then
    # Anchor the match at line start, like `localonly.find_block`: the rule's own prose quotes the marker
    # (this file did, and so does a rule-8 edit that shows the verify command), and `^+.*` matched that
    # text as if it were the block, refusing three landings of a refactored AGENTS.md on 2026-09-28.
    if git diff --cached -U0 -- AGENTS.md | grep -q '^+<!-- LOCAL-ONLY'; then
        echo "pre-commit: refusing AGENTS.md - the staged version contains the LOCAL-ONLY working-state block." >&2
        echo "  Run 'python tools/agents/localonly.py pull' before staging it (non-negotiable 8)." >&2
        exit 1
    fi
fi

exit 0
